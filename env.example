# Copy to .env.local for local development. See INFRASTRUCTURE_TODO.md for
# where each value comes from and what to set on Render for production.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Section 12.5 — Notifications. Optional: without this, emails log to the
# console instead of sending (see apps/web/lib/notifications.ts).
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Section 7 — seller "Connect account" OAuth per cross-posting channel (see
# apps/web/lib/channelOAuth.ts and INFRASTRUCTURE_TODO.md #9). Optional per
# channel — a channel just shows as "not connectable yet" until its vars
# are set. eBay and Etsy's authorize/token URLs are built in (public,
# documented endpoints); Depop/Whatnot/StockX gate API access behind a
# direct application, so those three also need their AUTHORIZE_URL/TOKEN_URL
# supplied once that platform gives them to you.
CHANNEL_EBAY_CLIENT_ID=
CHANNEL_EBAY_CLIENT_SECRET=
CHANNEL_ETSY_CLIENT_ID=
CHANNEL_DEPOP_CLIENT_ID=
CHANNEL_DEPOP_CLIENT_SECRET=
CHANNEL_DEPOP_AUTHORIZE_URL=
CHANNEL_DEPOP_TOKEN_URL=
CHANNEL_WHATNOT_CLIENT_ID=
CHANNEL_WHATNOT_CLIENT_SECRET=
CHANNEL_WHATNOT_AUTHORIZE_URL=
CHANNEL_WHATNOT_TOKEN_URL=
CHANNEL_STOCKX_CLIENT_ID=
CHANNEL_STOCKX_CLIENT_SECRET=
CHANNEL_STOCKX_AUTHORIZE_URL=
CHANNEL_STOCKX_TOKEN_URL=

# Section 15 — signup bot protection (Cloudflare Turnstile). Optional: the
# widget on /signup just doesn't render until this is set, same as every
# other optional integration above. The matching Secret Key doesn't go
# here — it's pasted directly into Supabase's own Attack Protection
# settings, see INFRASTRUCTURE_TODO.md #15 for the full walkthrough.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
